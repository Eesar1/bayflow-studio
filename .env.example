# PostgreSQL connection (use a dedicated database for BayFlow).
DATABASE_URL=postgresql://bayflow:bayflow_local@localhost:5434/bayflow
# Optional direct PostgreSQL connection for schema migrations (Neon unpooled URL).
DATABASE_URL_UNPOOLED=
# Public application origin; Vercel production uses its project production URL when available.
BETTER_AUTH_URL=http://localhost:3010
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
