    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "latest",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4",
    "tsx": "latest",
